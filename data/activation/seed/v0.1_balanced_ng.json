{"package_id":"mimo_pal_activation_seed_v0.2","version":"0.2.0","description":"Expanded balanced seed pcm/yor/ibo/hau from HF + public proverb sources. P1 only — not community ground truth.","languages":["pcm","yor","ibo","hau"],"curated_at":"2026-09-28","expressions":[{"id":"expr_pcm_hustle_pass_001","source_text":"No be who hustle pass na him go get money.","language":"pcm","register":"proverbial","interpretations":[{"type":"literal","content":"It is not the person who hustles the most who will get money.","status":"P1_source_derived"},{"type":"cultural","content":"Effort and financial reward are not necessarily proportional.","status":"P1_source_derived"}],"representation_hints":{"literal_cultural_divergence":true,"demo_state_if_unknown":"POSSIBLE_MEANING_LOSS"},"provenance":{"source_name":"Naija proverbial discourse","source_url_or_ref":"WAZOBIALABS/nigerian-pidgin-voice-text","license_note":"Seed paraphrase","curated_at":"2026-09-28"},"status":"seed","tags":["pcm","demo_gap"]},{"id":"expr_pcm_small_wahala_002","source_text":"Small wahala fit give you big stress.","language":"pcm","register":"proverbial","interpretations":[{"type":"literal","content":"A small problem can give you big stress.","status":"P1_source_derived"},{"type":"cultural","content":"Minor troubles can escalate into serious pressure.","status":"P1_source_derived"}],"representation_hints":{"literal_cultural_divergence":false,"demo_state_if_unknown":"UNDERSTOOD"},"provenance":{"source_name":"BBC Pidgin discourse studies","source_url_or_ref":"Uniben LING materials","license_note":"Public research","curated_at":"2026-09-28"},"status":"seed","tags":["pcm"]},{"id":"expr_yor_eye_house_001","source_text":"A kì í fi ẹyẹlé sọ ilé.","language":"yor","register":"proverbial","interpretations":[{"type":"literal","content":"One does not use a pigeon to watch the house.","status":"P1_source_derived"},{"type":"cultural","content":"Do not entrust heavy responsibilities to someone unreliable.","status":"P1_source_derived"}],"representation_hints":{"literal_cultural_divergence":true,"demo_state_if_unknown":"POSSIBLE_MEANING_LOSS"},"provenance":{"source_name":"saaga/yoruba-cultural-reasoning-blindspots","source_url_or_ref":"https://huggingface.co/datasets/saaga/yoruba-cultural-reasoning-blindspots","license_note":"MIT","curated_at":"2026-09-28"},"status":"seed","tags":["yor","demo_gap"]},{"id":"expr_yor_pig_fence_002","source_text":"Díẹ̀ díẹ̀ nimú ẹlẹ́dẹ̀ fi ń wọgbà.","language":"yor","register":"proverbial","interpretations":[{"type":"literal","content":"Little by little is how the pig's nose enters the fence.","status":"P1_source_derived"},{"type":"cultural","content":"Small ignored problems escalate into major crises.","status":"P1_source_derived"}],"representation_hints":{"literal_cultural_divergence":true,"demo_state_if_unknown":"POSSIBLE_MEANING_LOSS"},"provenance":{"source_name":"saaga/yoruba-cultural-reasoning-blindspots","source_url_or_ref":"https://huggingface.co/datasets/saaga/yoruba-cultural-reasoning-blindspots","license_note":"MIT","curated_at":"2026-09-28"},"status":"seed","tags":["yor","demo_gap"]},{"id":"expr_yor_child_hand_003","source_text":"Ọwọ́ ọmọdé kò tó pẹpẹ, tàgbàlàgbà kò wọ kèrègbè.","language":"yor","register":"proverbial","interpretations":[{"type":"literal","content":"A child's hand cannot reach the high shelf; an elder's cannot enter a gourd.","status":"P1_source_derived"},{"type":"cultural","content":"Everyone has unique strengths and limits; cooperation is essential.","status":"P1_source_derived"}],"representation_hints":{"literal_cultural_divergence":true,"demo_state_if_unknown":"POSSIBLE_MEANING_LOSS"},"provenance":{"source_name":"saaga/yoruba-cultural-reasoning-blindspots","source_url_or_ref":"https://huggingface.co/datasets/saaga/yoruba-cultural-reasoning-blindspots","license_note":"MIT","curated_at":"2026-09-28"},"status":"seed","tags":["yor"]},{"id":"expr_ibo_snake_bush_001","source_text":"Agwọ amaka n'ọhịa ka a na-egbu n'ụlọ","language":"ibo","register":"proverbial","interpretations":[{"type":"literal","content":"A snake is fine in the bush until killed in the house.","status":"P1_source_derived"},{"type":"cultural","content":"Distant problems become serious when they reach home.","status":"P1_source_derived"}],"representation_hints":{"literal_cultural_divergence":true,"demo_state_if_unknown":"POSSIBLE_MEANING_LOSS"},"provenance":{"source_name":"0xnu/igbo","source_url_or_ref":"https://huggingface.co/datasets/0xnu/igbo","license_note":"See dataset card","curated_at":"2026-09-28","curator_note":"needs_speaker_review"},"status":"seed","tags":["ibo","needs_speaker_review"]},{"id":"expr_hau_elephant_trunk_001","source_text":"Giwa ba ta da cizo, hannun nan a ke tsoro.","language":"hau","register":"proverbial","interpretations":[{"type":"literal","content":"The elephant does not bite; it is the trunk people fear.","status":"P1_source_derived"},{"type":"cultural","content":"Danger may come from the instrument of force, not only from size.","status":"P1_source_derived"}],"representation_hints":{"literal_cultural_divergence":true,"demo_state_if_unknown":"POSSIBLE_MEANING_LOSS"},"provenance":{"source_name":"Traditional Hausa karin magana lists","source_url_or_ref":"https://www.atlanticride.com/100-hausa-proverbs-their-meanings/","license_note":"Public traditional sayings","curated_at":"2026-09-28","curator_note":"needs_speaker_review"},"status":"seed","tags":["hau","needs_speaker_review"]},{"id":"expr_hau_bed_mat_002","source_text":"Mai-gado ya so kwana, mai-tabarma sai shi naɗe.","language":"hau","register":"proverbial","interpretations":[{"type":"literal","content":"The bed owner wants to sleep; the mat owner must roll it up.","status":"P1_source_derived"},{"type":"cultural","content":"When greater claim needs space, the temporary occupant yields.","status":"P1_source_derived"}],"representation_hints":{"literal_cultural_divergence":true,"demo_state_if_unknown":"POSSIBLE_MEANING_LOSS"},"provenance":{"source_name":"Traditional Hausa karin magana lists","source_url_or_ref":"https://www.atlanticride.com/100-hausa-proverbs-their-meanings/","license_note":"Public traditional sayings","curated_at":"2026-09-28"},"status":"seed","tags":["hau","needs_speaker_review"]},{"id":"expr_pcm_unknown_gap_003","source_text":"Water wey pass gari, e don pass gari.","language":"pcm","register":"idiomatic","interpretations":[{"type":"literal","content":"Water that has passed gari has passed gari.","status":"P1_source_derived"}],"representation_hints":{"literal_cultural_divergence":true,"demo_state_if_unknown":"INSUFFICIENT_KNOWLEDGE"},"provenance":{"source_name":"Internal gap fixture","source_url_or_ref":"internal://fixtures/gap_demo","license_note":"Evaluation only","curated_at":"2026-09-28"},"status":"evaluation","tags":["pcm","gap_fixture"]},{"id":"expr_yor_anger_cap_004","source_text":"A kì í bínú orí ká fi fìlà dé ìbàdí.","language":"yor","register":"proverbial","interpretations":[{"type":"literal","content":"One does not get so angry at the head that one wears the cap on the buttocks.","status":"P1_source_derived"},{"type":"cultural","content":"Do not let anger cause you to act irrationally or harm your own interests.","status":"P1_source_derived"}],"representation_hints":{"literal_cultural_divergence":true,"demo_state_if_unknown":"POSSIBLE_MEANING_LOSS"},"provenance":{"source_name":"saaga/yoruba-cultural-reasoning-blindspots","source_url_or_ref":"https://huggingface.co/datasets/saaga/yoruba-cultural-reasoning-blindspots","license_note":"MIT","curated_at":"2026-09-28"},"status":"seed","tags":["yor","demo_gap","saaga"]},{"id":"expr_yor_stone_market_005","source_text":"Bí a bá sọ òkò sọ́jà, ará ilé ẹni ní bá.","language":"yor","register":"proverbial","interpretations":[{"type":"literal","content":"If we throw a stone into the market, it is our own relative it will hit.","status":"P1_source_derived"},{"type":"cultural","content":"Reckless or malicious actions often end up hurting those closest to you.","status":"P1_source_derived"}],"representation_hints":{"literal_cultural_divergence":true,"demo_state_if_unknown":"POSSIBLE_MEANING_LOSS"},"provenance":{"source_name":"saaga/yoruba-cultural-reasoning-blindspots","source_url_or_ref":"https://huggingface.co/datasets/saaga/yoruba-cultural-reasoning-blindspots","license_note":"MIT","curated_at":"2026-09-28"},"status":"seed","tags":["yor","demo_gap","saaga"]},{"id":"expr_yor_pot_pepper_006","source_text":"Ìkòkò tí yóò jẹ ata, ìdí rẹ̀ á gbóná.","language":"yor","register":"proverbial","interpretations":[{"type":"literal","content":"The pot that will eat pepper, its bottom will get hot.","status":"P1_source_derived"},{"type":"cultural","content":"Success and good results require enduring hardship and hard work.","status":"P1_source_derived"}],"representation_hints":{"literal_cultural_divergence":true,"demo_state_if_unknown":"POSSIBLE_MEANING_LOSS"},"provenance":{"source_name":"saaga/yoruba-cultural-reasoning-blindspots","source_url_or_ref":"https://huggingface.co/datasets/saaga/yoruba-cultural-reasoning-blindspots","license_note":"MIT","curated_at":"2026-09-28"},"status":"seed","tags":["yor","demo_gap","saaga"]},{"id":"expr_yor_shame_disease_007","source_text":"A kì í fi ìtìjú kárùn.","language":"yor","register":"proverbial","interpretations":[{"type":"literal","content":"One does not use shame to contract a disease.","status":"P1_source_derived"},{"type":"cultural","content":"Do not hide problems or illnesses out of shame; seek help to survive.","status":"P1_source_derived"}],"representation_hints":{"literal_cultural_divergence":true,"demo_state_if_unknown":"POSSIBLE_MEANING_LOSS"},"provenance":{"source_name":"saaga/yoruba-cultural-reasoning-blindspots","source_url_or_ref":"https://huggingface.co/datasets/saaga/yoruba-cultural-reasoning-blindspots","license_note":"MIT","curated_at":"2026-09-28"},"status":"seed","tags":["yor","demo_gap","saaga"]},{"id":"expr_yor_soft_head_008","source_text":"Orí bẹbẹ lẹgùn ń gùn.","language":"yor","register":"proverbial","interpretations":[{"type":"literal","content":"It is the soft head that the thorn climbs.","status":"P1_source_derived"},{"type":"cultural","content":"People tend to take advantage of those who are overly accommodating or soft-spoken.","status":"P1_source_derived"}],"representation_hints":{"literal_cultural_divergence":true,"demo_state_if_unknown":"POSSIBLE_MEANING_LOSS"},"provenance":{"source_name":"saaga/yoruba-cultural-reasoning-blindspots","source_url_or_ref":"https://huggingface.co/datasets/saaga/yoruba-cultural-reasoning-blindspots","license_note":"MIT","curated_at":"2026-09-28"},"status":"seed","tags":["yor","demo_gap","saaga"]},{"id":"expr_yor_palace_fire_009","source_text":"Ilé ọba tójó ẹwà ló bùkún un.","language":"yor","register":"proverbial","interpretations":[{"type":"literal","content":"The king's palace burned; it became more beautiful.","status":"P1_source_derived"},{"type":"cultural","content":"A disaster or setback can sometimes pave the way for a greater achievement.","status":"P1_source_derived"}],"representation_hints":{"literal_cultural_divergence":true,"demo_state_if_unknown":"POSSIBLE_MEANING_LOSS"},"provenance":{"source_name":"saaga/yoruba-cultural-reasoning-blindspots","source_url_or_ref":"https://huggingface.co/datasets/saaga/yoruba-cultural-reasoning-blindspots","license_note":"MIT","curated_at":"2026-09-28"},"status":"seed","tags":["yor","demo_gap","saaga"]},{"id":"expr_yor_chicken_intestines_010","source_text":"A kì í rí adìẹ ní ìfun.","language":"yor","register":"proverbial","interpretations":[{"type":"literal","content":"One does not see a chicken in the intestines.","status":"P1_source_derived"},{"type":"cultural","content":"Certain secrets or private family matters should be kept hidden from the public.","status":"P1_source_derived"}],"representation_hints":{"literal_cultural_divergence":true,"demo_state_if_unknown":"POSSIBLE_MEANING_LOSS"},"provenance":{"source_name":"saaga/yoruba-cultural-reasoning-blindspots","source_url_or_ref":"https://huggingface.co/datasets/saaga/yoruba-cultural-reasoning-blindspots","license_note":"MIT","curated_at":"2026-09-28"},"status":"seed","tags":["yor","demo_gap","saaga"]},{"id":"expr_pcm_monkey_hand_004","source_text":"Monkey dey work, baboon dey chop.","language":"pcm","register":"proverbial","interpretations":[{"type":"literal","content":"The monkey is working while the baboon is eating.","status":"P1_source_derived"},{"type":"cultural","content":"Some people do the labour while others unfairly enjoy the benefits.","status":"P1_source_derived"}],"representation_hints":{"literal_cultural_divergence":true,"demo_state_if_unknown":"POSSIBLE_MEANING_LOSS"},"provenance":{"source_name":"Naija proverbial discourse (common documented constructions)","source_url_or_ref":"public Naija proverb lists / PCM discourse","license_note":"Seed paraphrase for activation demo","curated_at":"2026-09-28"},"status":"seed","tags":["pcm","demo_gap"]},{"id":"expr_pcm_softly_softly_005","source_text":"Softly softly catch monkey.","language":"pcm","register":"proverbial","interpretations":[{"type":"literal","content":"Softly softly catch monkey.","status":"P1_source_derived"},{"type":"cultural","content":"Patience and careful strategy succeed better than force.","status":"P1_source_derived"}],"representation_hints":{"literal_cultural_divergence":true,"demo_state_if_unknown":"POSSIBLE_MEANING_LOSS"},"provenance":{"source_name":"Naija proverbial discourse (common documented constructions)","source_url_or_ref":"public Naija proverb lists / PCM discourse","license_note":"Seed paraphrase for activation demo","curated_at":"2026-09-28"},"status":"seed","tags":["pcm","demo_gap"]},{"id":"expr_ibo_hand_wash_002","source_text":"Aka nri kwọọ aka ekpe, aka ekpe akwọọ aka nri.","language":"ibo","register":"proverbial","interpretations":[{"type":"literal","content":"The right hand washes the left hand, and the left washes the right.","status":"P1_source_